{
  "annotations": {
    "list": []
  },
  "description": "Bowire self-telemetry overview — invoke / discover / mock / plugin signals emitted via the canonical `Kuestenlogik.Bowire` Meter (#29). Import into Grafana 11+ pointed at the Prometheus / Mimir datasource that scrapes your OpenTelemetry collector. Variables: `$datasource` (Prometheus datasource), `$protocol` (filter by the protocol dimension).",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "icon": "external link",
      "tags": [],
      "targetBlank": true,
      "title": "Bowire docs",
      "tooltip": "Bowire self-telemetry reference",
      "type": "link",
      "url": "https://bowire.io/docs/features/self-telemetry.html"
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Invoke",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Invokes (rate / s)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum(rate(bowire_invoke_count_total{protocol=~\"$protocol\"}[1m]))",
          "legendFormat": "invokes/s",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "stat",
      "title": "Error ratio",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum(rate(bowire_invoke_count_total{protocol=~\"$protocol\",outcome!=\"ok\"}[5m])) / clamp_min(sum(rate(bowire_invoke_count_total{protocol=~\"$protocol\"}[5m])), 1)",
          "legendFormat": "error ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Invoke duration (p50 / p95 / p99)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(bowire_invoke_duration_milliseconds_bucket{protocol=~\"$protocol\"}[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(bowire_invoke_duration_milliseconds_bucket{protocol=~\"$protocol\"}[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(bowire_invoke_duration_milliseconds_bucket{protocol=~\"$protocol\"}[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "type": "timeseries",
      "title": "Invokes by protocol",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 7 },
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (protocol) (rate(bowire_invoke_count_total{protocol=~\"$protocol\"}[1m]))",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "row",
      "title": "Discover",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 16 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Discovery probes (rate / s by outcome)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(bowire_discover_count_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Discovery probes by protocol",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (protocol) (rate(bowire_discover_count_total[1m]))",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "row",
      "title": "Mock",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Mock requests by outcome",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 27 },
      "id": 7,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(bowire_mock_requests_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "timeseries",
      "title": "Mock requests by HTTP status",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 27 },
      "id": 8,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (status_code) (rate(bowire_mock_requests_total[1m]))",
          "legendFormat": "{{status_code}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "type": "row",
      "title": "Plugin lifecycle",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Plugin load attempts at startup",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 37 },
      "id": 9,
      "datasource": { "type": "prometheus", "uid": "$datasource" },
      "targets": [
        {
          "expr": "sum by (plugin, outcome) (bowire_plugin_load_total)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true } } }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["bowire", "self-telemetry"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "$datasource" },
        "hide": 0,
        "includeAll": true,
        "label": "Protocol",
        "multi": true,
        "name": "protocol",
        "options": [],
        "query": "label_values(bowire_invoke_count_total, protocol)",
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Bowire — self-telemetry overview",
  "uid": "bowire-overview",
  "version": 1
