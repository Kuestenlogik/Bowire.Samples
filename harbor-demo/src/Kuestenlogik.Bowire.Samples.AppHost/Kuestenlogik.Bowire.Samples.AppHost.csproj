<Project Sdk="Microsoft.NET.Sdk">
  <!-- The AppHost SDK and Aspire.Hosting.AppHost move together: the SDK names the
       Aspire CLI version the AppHost runs through (aspire.cli@<SDK version>). -->
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- DCP and the dashboard come from the Aspire CLI bundle (an `aspire` on PATH,
         otherwise the SDK-paired aspire.cli package through dnx), not from NuGet
         packages restored per platform. Leaving it false raises ASPIRE010:
         https://aspire.dev/diagnostics/aspire010/ -->
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Fleet\Kuestenlogik.Bowire.Samples.Fleet.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Inventory\Kuestenlogik.Bowire.Samples.Inventory.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Gate\Kuestenlogik.Bowire.Samples.Gate.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.PortCalls\Kuestenlogik.Bowire.Samples.PortCalls.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Tracking\Kuestenlogik.Bowire.Samples.Tracking.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Operations\Kuestenlogik.Bowire.Samples.Operations.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Arrivals\Kuestenlogik.Bowire.Samples.Arrivals.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Telemetry\Kuestenlogik.Bowire.Samples.Telemetry.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Assistant\Kuestenlogik.Bowire.Samples.Assistant.csproj" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Gateway\Kuestenlogik.Bowire.Samples.Gateway.csproj" />
  </ItemGroup>
</Project>
