<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!-- Bowire host + the AMQP protocol plugin. AddBowire / MapBowire
         scan the load context for IBowireProtocol implementations, so
         the plugin package is all we need for the workbench to surface
         AMQP in its sidebar — no manual registration. -->
    <PackageReference Include="Kuestenlogik.Bowire" Version="2.3.0" />
    <PackageReference Include="Kuestenlogik.Bowire.Protocol.Amqp" Version="0.2.1" />

    <!-- RabbitMQ AMQP 0.9.1 client for the publisher loop. The broker
         itself is Erlang-only, so this sample uses a Docker-supplied
         RabbitMQ (see compose.yaml next to the project) — there is no
         in-process AMQP 0.9.1 broker for .NET, unlike the embedded
         MQTTnet broker the MQTT sample uses. -->
    <PackageReference Include="RabbitMQ.Client" Version="7.2.1" />
    <ProjectReference Include="..\Kuestenlogik.Bowire.Samples.Shared\Kuestenlogik.Bowire.Samples.Shared.csproj" />
  </ItemGroup>
</Project>
