<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>Canonical TacticalAPI mini-server — three radar tracks rotating around a single grid centre, served via the GetSituationObjects + SubscribeSituationObjectEvents calls. Use this to test the Bowire TacticalAPI plugin against a small, read-only target without pulling in the full Harbor demo.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.81.1" PrivateAssets="All" />
  </ItemGroup>

  <!--
    Mirrors the proto-fetch pattern from the Harbor TacticalApi sample
    + the Bowire.Protocol.TacticalApi plugin. The upstream .proto files
    sit at github.com/Rheinmetall/tacticalapi under EPL-2.0 OR
    BSD-3-Clause; vendoring them into this Apache-2.0 repo would be a
    license-different redistribution, so we fetch into obj/ at build
    time and only the generated server bindings ship in the assembly.

    Pinned commit MUST match the plugin's TacticalApiProtoSha + the
    Harbor sample's pin so wire shapes line up across client and
    server. Re-pin all three together when the upstream proto bumps.
  -->
  <PropertyGroup>
    <TacticalApiProtoSha>e68546809d981cd649325dba4a9702c1a77a1a0b</TacticalApiProtoSha>
    <TacticalApiProtoBaseUrl>https://raw.githubusercontent.com/Rheinmetall/tacticalapi/$(TacticalApiProtoSha)/rheinmetall/tactical_api/v0</TacticalApiProtoBaseUrl>
    <TacticalApiProtoRoot>$(IntermediateOutputPath)tacticalapi-protos\</TacticalApiProtoRoot>
    <TacticalApiProtoDir>$(TacticalApiProtoRoot)rheinmetall\tactical_api\v0\</TacticalApiProtoDir>
  </PropertyGroup>

  <Target Name="DownloadTacticalApiProtos"
          BeforeTargets="PrepareForBuild;Protobuf_Compile"
          Inputs="$(MSBuildThisFileFullPath)"
          Outputs="$(TacticalApiProtoDir).fetch-stamp">
    <MakeDir Directories="$(TacticalApiProtoDir)" />

    <ItemGroup>
      <_TacticalApiProtoFile Include="service_types.proto" />
      <_TacticalApiProtoFile Include="situation_object_locations.proto" />
      <_TacticalApiProtoFile Include="situation_object_types.proto" />
      <_TacticalApiProtoFile Include="situation_object_updates.proto" />
      <_TacticalApiProtoFile Include="situation_service.proto" />
      <_TacticalApiProtoFile Include="types.proto" />
    </ItemGroup>

    <Message Importance="high"
             Text="Fetching TacticalAPI .proto files from $(TacticalApiProtoBaseUrl)" />

    <DownloadFile SourceUrl="$(TacticalApiProtoBaseUrl)/%(_TacticalApiProtoFile.Identity)"
                  DestinationFolder="$(TacticalApiProtoDir)"
                  SkipUnchangedFiles="true" />

    <Touch Files="$(TacticalApiProtoDir).fetch-stamp" AlwaysCreate="true" />
  </Target>

  <Target Name="AddTacticalApiProtobufItems"
          AfterTargets="DownloadTacticalApiProtos"
          BeforeTargets="Protobuf_Compile">
    <ItemGroup>
      <Protobuf Include="$(TacticalApiProtoDir)*.proto"
                ProtoRoot="$(TacticalApiProtoRoot)"
                GrpcServices="Server"
                Access="Public"
                CompileOutputs="true" />
    </ItemGroup>
  </Target>

</Project>
