<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Kuestenlogik.Bowire.* and everything else resolves from nuget.org.
       RC versions land there too (with their SemVer pre-release suffix),
       so consumers who pin an RC explicitly — e.g. `<PackageReference
       Version="1.1.0-rc.3" />` — get it from the canonical feed without
       any GitHub Packages plumbing. No PAT, no fallback source. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
